# Porta em que a API REST vai rodar
PORT=3000

# Conexão com o PostgreSQL (usuário:senha@host:porta/banco)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mytask

# Chave usada para assinar os tokens JWT (troque por um texto longo e aleatório)
JWT_SECRET=troque-esta-chave-por-um-texto-longo-e-aleatorio

# Tempo de validade do token de login
JWT_EXPIRES_IN=8h

# Endereço do front-end autorizado a chamar a API (CORS)
CORS_ORIGIN=http://localhost:5173
